{
  "env": {
    "EDITOR": "nvim",
    "VISUAL": "nvim"
  },
  "permissions": {
    "allow": [
      "mcp__claude_ai_Linear"
    ],
    "deny": [
      "EnterPlanMode",
      "ExitPlanMode",
      "DesignSync",
      "NotebookEdit",
      "PushNotification",
      "RemoteTrigger",
      "ReportFindings",
      "ScheduleWakeup",
      "CronCreate",
      "CronDelete",
      "CronList"
    ],
    "ask": [],
    "defaultMode": "auto",
    "additionalDirectories": [
      "/tmp"
    ]
  },
  "model": "opus",
  "disableClaudeAiConnectors": false,
  "disableBundledSkills": true,
  "hooks": {
    "SessionStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "bash '/Users/moralesbang/.claude/hooks/herdr-agent-state.sh' session",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "disableArtifact": true,
  "statusLine": {
    "type": "command",
    "command": "bunx -y ccstatusline@latest",
    "padding": 0
  },
  "feedbackDrafts": "quiet",
  "effortLevel": "high",
  "promptSuggestionEnabled": false,
  "dialogExpiry": "5m",
  "tui": "fullscreen",
  "autoMemoryEnabled": false,
  "skipDangerousModePermissionPrompt": true,
  "theme": "custom:catppuccin-macchiato",
  "editorMode": "normal",
  "autoCompactEnabled": true,
  "autoContinueAtUsageLimit": false,
  "agentPushNotifEnabled": true,
  "voiceEnabled": false
}
