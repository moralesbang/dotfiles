{
  "syncClaudeAiSkills": false,
  "env": {
    "EDITOR": "nvim"
  },
  "permissions": {
    "allow": [
      "Read(~/.agents/skills/**)"
    ],
    "deny": [
      "Read(~/Projects/Work/_workspace/.secrets/**)",
      "Read(~/Projects/work-harness/overlay/_workspace/.secrets/**)",
      "EnterPlanMode",
      "ExitPlanMode",
      "DesignSync",
      "NotebookEdit",
      "PushNotification",
      "RemoteTrigger",
      "ReportFindings",
      "ScheduleWakeup",
      "CronCreate",
      "CronDelete",
      "CronList"
    ]
  },
  "model": "opus",
  "disableClaudeAiConnectors": false,
  "skillOverrides": {
    "code-review": "off"
  },
  "disableBundledSkills": true,
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash '/Users/moralesbang/.claude/hooks/block-skills-all-agents.sh'",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "bash '/Users/moralesbang/.claude/skills/work-dependency-bump/scripts/check.sh' --hook",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "f=\"$HOME/.claude/hooks/local/session-start.sh\"; [ -f \"$f\" ] && bash \"$f\"; exit 0",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "disableArtifact": true,
  "statusLine": {
    "type": "command",
    "command": "bunx -y ccstatusline@latest",
    "padding": 0
  },
  "enabledPlugins": {
    "finance@synced": false,
    "typescript-lsp@claude-plugins-official": true
  },
  "feedbackDrafts": "quiet",
  "effortLevel": "high",
  "modelSettings": {
    "claude-opus-5-5": {
      "effortLevel": "high"
    }
  },
  "promptSuggestionEnabled": false,
  "tui": "fullscreen",
  "autoMemoryEnabled": false,
  "theme": "custom:catppuccin-mocha",
  "autoCompactEnabled": false,
  "switchModelsOnFlag": true,
  "agentPushNotifEnabled": false
}
